<Window x:Class="ZeeplogWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZEEPLOG" Height="680" Width="540"
        MinWidth="480" MinHeight="560"
        Background="#1E1E1E"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF7700"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC6600"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource DarkBtn}">
            <Setter Property="Background" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#404040"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 타이틀 -->
            <RowDefinition Height="Auto"/>   <!-- 파일 선택 버튼 -->
            <RowDefinition Height="130"/>    <!-- 파일 목록 -->
            <RowDefinition Height="Auto"/>   <!-- 변환 형식 -->
            <RowDefinition Height="Auto"/>   <!-- 변환 시작 버튼 -->
            <RowDefinition Height="Auto"/>   <!-- 프로그레스 -->
            <RowDefinition Height="*"/>      <!-- 로그 -->
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="ZEEPLOG" FontSize="26" FontWeight="Bold"
                       Foreground="#FF7700"/>
            <TextBlock Text="  운동 기록 변환기" FontSize="14"
                       VerticalAlignment="Bottom" Margin="0,0,0,3"
                       Foreground="#888888"/>
        </StackPanel>

        <!-- 파일 선택 -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📂  파일 추가  (FIT / GPX / TCX)"
                    Style="{StaticResource GhostBtn}"
                    Click="BtnAddFiles_Click" Height="38" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="전체 삭제"
                    Style="{StaticResource GhostBtn}"
                    Click="BtnClearFiles_Click" Height="38" Width="80"/>
        </Grid>

        <!-- 파일 목록 (드래그 앤 드롭 가능) -->
        <Border Grid.Row="2" BorderBrush="#3E3E42" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,16">
            <Grid>
                <ListBox x:Name="LbFiles" BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" FontFamily="Consolas"
                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="✕" Width="20" Height="16"
                                        FontSize="10" Margin="4,0,0,0"
                                        Style="{StaticResource GhostBtn}"
                                        Tag="{Binding}"
                                        Click="BtnRemoveFile_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TbDropHint"
                           Text="여기에 파일을 드래그 앤 드롭 하거나 위 버튼으로 추가하세요"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#555555" FontSize="12"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 변환 형식 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="변환 형식:" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <RadioButton x:Name="RbCsv"   Content="CSV (FIT 전용)" IsChecked="True"/>
            <RadioButton x:Name="RbVideo" Content="영상 (MP4)"/>
            <RadioButton x:Name="RbBoth"  Content="둘 다"/>
            <Separator Width="1" Height="20" Background="#444444" Margin="8,0"/>
            <TextBlock Text="영상 배속:" VerticalAlignment="Center" Margin="8,0,8,0"/>
            <TextBox x:Name="TbFps" Text="60" Width="50" Height="26"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="FPS" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="#666666"/>
        </StackPanel>

        <!-- 변환 시작 버튼 -->
        <Button Grid.Row="4" x:Name="BtnConvert"
                Content="변환 시작"
                Style="{StaticResource DarkBtn}"
                Height="44" FontSize="15"
                Click="BtnConvert_Click"
                Margin="0,0,0,14"/>

        <!-- 프로그레스 -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <ProgressBar x:Name="PbProgress" Height="6" Minimum="0" Maximum="100"
                         Background="#333333" Foreground="#FF7700"
                         BorderThickness="0" Margin="0,0,0,5"/>
            <TextBlock x:Name="TbStatus" Text="대기 중" FontSize="11"
                       Foreground="#666666"/>
        </StackPanel>

        <!-- 로그 출력 -->
        <Border Grid.Row="6" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
            <ScrollViewer x:Name="SvLog" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TbLog"
                           Foreground="#AAAAAA"
                           FontFamily="Consolas" FontSize="11"
                           Padding="8,6"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
